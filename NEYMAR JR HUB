local function FindPlayerByNameTools(name)
    if not name or name == "" then return nil end
    
    local player = Players:FindFirstChild(name)
    if player then return player end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.DisplayName and p.DisplayName:lower() == name:lower() then
            return p
        end
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name and p.Name:lower():find(name:lower()) then
            return p
        end
        if p.DisplayName and p.DisplayName:lower():find(name:lower()) then
            return p
        end
    end
    
    return nil
end

local function EquipBananaPeelTools()
    local char = LocalPlayer.Character
    if not char then return false end
    
    if char:FindFirstChild("Minions2026_BananaPeel") then
        return true
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local bananaPeel = backpack:FindFirstChild("Minions2026_BananaPeel")
        if bananaPeel then
            bananaPeel.Parent = char
            wait(0.2)
            if char:FindFirstChild("Minions2026_BananaPeel") then
                return true
            end
        end
    end
    
    local success = pcall(function()
        local Event1 = ReplicatedStorage:FindFirstChild("RE")
        if Event1 then
            local Event1Too1l = Event1:FindFirstChild("1Too1l")
            if Event1Too1l then
                Event1Too1l:InvokeServer("PickingTools", "Minions2026_BananaPeel")
            end
        end
    end)
    
    if success then
        wait(0.5)
        if char:FindFirstChild("Minions2026_BananaPeel") then
            return true
        end
    end
    
    return false
end

local function PlaceBananaAtPlayerTools(targetPlayer)
    if not targetPlayer then return false end
    
    local targetCharacter = targetPlayer.Character
    if not targetCharacter then return false end
    
    if not EquipBananaPeelTools() then return false end
    
    local foot = targetCharacter:FindFirstChild("LeftFoot") or targetCharacter:FindFirstChild("RightFoot") or targetCharacter:FindFirstChild("HumanoidRootPart")
    if not foot then return false end
    
    local footPosition = foot.Position + Vector3.new(0, -0.3, 0)
    
    local success = pcall(function()
        local char = LocalPlayer.Character
        if char then
            local bananaPeel = char:FindFirstChild("Minions2026_BananaPeel")
            if bananaPeel then
                local placeEvent = bananaPeel:FindFirstChild("PlaceBananaPeel")
                if placeEvent then
                    placeEvent:FireServer(footPosition)
                end
            end
        end
    end)
    
    return success
end

local bananaLoopActiveTools = false
local bananaTargetTools = nil

local function StartBananaLoopTools()
    if not toolsSelectedPlayer then
        warn("Nenhum jogador selecionado para loop de banana!")
        return
    end
    
    local targetPlayer = FindPlayerByNameTools(toolsSelectedPlayer)
    if not targetPlayer then
        warn("Jogador não encontrado!")
        return
    end
    
    bananaLoopActiveTools = true
    bananaTargetTools = toolsSelectedPlayer
    
    task.spawn(function()
        while bananaLoopActiveTools do
            local currentTarget = FindPlayerByNameTools(bananaTargetTools)
            if currentTarget then
                PlaceBananaAtPlayerTools(currentTarget)
            end
            task.wait(1)
        end
    end)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Loop Banana",
        Text = "Loop de banana ATIVADO!",
        Duration = 2
    })
end

local function StopBananaLoopTools()
    bananaLoopActiveTools = false
    bananaTargetTools = nil
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Loop Banana",
        Text = "Loop de banana DESATIVADO!",
        Duration = 2
    })
end

