local function FlingWithCouch(target)
    if not target or not target.Character then return end
    
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local camera = workspace.CurrentCamera
    local originalSubject = camera.CameraSubject
    
    local tchar = target.Character
    local troot = tchar:FindFirstChild("HumanoidRootPart")
    local thum = tchar:FindFirstChild("Humanoid")
    if not troot or not thum then return end

    if thum then
        camera.CameraSubject = thum
    end

    ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllTools")
    task.wait(0.2)

    ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
    task.wait(0.3)

    local couch = player.Backpack:FindFirstChild("Couch")
    if couch then
        couch.Parent = character
    end
    task.wait(0.1)

    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.25)

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local originalCFrame = rootPart.CFrame

    workspace.FallenPartsDestroyHeight = 0/0

    local force = Instance.new("BodyVelocity")
    force.Name = "FlingForce"
    force.Velocity = Vector3.new(9e8, 9e8, 9e8)
    force.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    force.Parent = rootPart

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    humanoid.PlatformStand = false

    local isFlinging = true
    local angle = 0

    task.spawn(function()
        while isFlinging and target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") do
            local targetHumanoid = target.Character:FindFirstChildOfClass("Humanoid")
            if targetHumanoid.Sit then break end

            local hrp = target.Character.HumanoidRootPart
            angle = angle + 50
            local pos = hrp.Position
            
            rootPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)) * CFrame.Angles(math.rad(angle), 0, 0)
            rootPart.Velocity = Vector3.new(9e8, 9e8, 9e8)
            rootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            task.wait()
        end

        isFlinging = false
        force:Destroy()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        humanoid.PlatformStand = false
        rootPart.CFrame = originalCFrame
        
        if originalSubject then
            camera.CameraSubject = originalSubject
        elseif player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
        end

        for _, p in pairs(character:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Velocity = Vector3.zero
                p.RotVelocity = Vector3.zero
            end
        end

        humanoid:UnequipTools()
        ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
    end)
end

